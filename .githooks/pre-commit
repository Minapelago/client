#!/usr/bin/env bash
#
# Format the C/C++ sources with format.sh, then re-stage the staged ones.
# Enable with: git config core.hooksPath .githooks
# Bypass once with: git commit --no-verify
#
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR -z -- '*.cpp' '*.hpp' '*.h' | tr '\0' '\n')

[ -n "$staged" ] || exit 0

bash "$(git rev-parse --show-toplevel)/format.sh"

printf '%s\n' "$staged" | while IFS= read -r f; do
    git add -- "$f"
done

echo "pre-commit: clang-format applied to staged C/C++ sources."
